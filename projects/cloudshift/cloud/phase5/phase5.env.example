# REQUIRED: use an existing billing-enabled Google Cloud project.
PROJECT_ID=replace-with-your-project-id

# CloudShift defaults
REGION=me-central1
REPOSITORY=cloudshift
API_SERVICE=cloudshift-api
SHIPPING_SERVICE=cloudshift-shipping
FRONTEND_SERVICE=cloudshift-frontend
SQL_INSTANCE=cloudshift-postgres
DB_NAME=cloudshift
DB_USER=cloudshift_app
RUN_SERVICE_ACCOUNT=cloudshift-run
DB_PASSWORD_SECRET=cloudshift-db-password
SHIPPING_TOKEN_SECRET=cloudshift-shipping-token
