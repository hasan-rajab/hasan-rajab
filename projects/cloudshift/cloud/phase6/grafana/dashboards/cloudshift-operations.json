{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Request Rate (req/s)",
      "targets": [
        {
          "expr": "sum(rate(cloudshift_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "5xx Rate",
      "targets": [
        {
          "expr": "sum(rate(cloudshift_errors_total{status_class=\"5xx\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Audit Events",
      "targets": [
        {
          "expr": "sum(cloudshift_audit_events_total)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Shipping Successes",
      "targets": [
        {
          "expr": "sum(cloudshift_dependency_requests_total{dependency=\"shipping\",outcome=\"success\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "API P95 Latency by Path",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,path) (rate(cloudshift_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Shipping Dependency P95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cloudshift_dependency_duration_seconds_bucket{dependency=\"shipping\"}[5m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP Status Rate",
      "targets": [
        {
          "expr": "sum by (status) (rate(cloudshift_requests_total[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Firestore Write P95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cloudshift_firestore_write_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "cloudshift",
    "observability"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "CloudShift Operations",
  "uid": "cloudshift-ops",
